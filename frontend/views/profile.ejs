<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SimpleFinance - Profile</title>
    <script src="https://cdn.jsdelivr.net/npm/vue@2/dist/vue.js"></script>
    <link rel="icon" type="image/x-icon" href="./favicon.ico">
    <link rel="stylesheet" href="/static/main.css">
    <link rel="stylesheet" href="/static/header.css">
    <link rel="stylesheet" href="/static/footer.css">
    <link rel="stylesheet" href="/static/profile.css">
</head>

<body>
    <div id="server">
        <%- include('header'); -%>
        
        <div class="app-layout">
            
            <aside class="sidebar-left" v-if="loggedIn">
                <h3>Menu</h3>
                <p class="text-muted">Welcome, {{ inputUsername }}</p>
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/display">Dashboard</a></li>
                    <li><a href="/settings">Settings</a></li>
                </ul>
            </aside>

            <main class="content" style="max-width: 800px; margin: 0 auto;">
                
                <div class="profile-card">
                    <div class="profile-header">
                        <div class="avatar-container">
                            <img src="https://thispersondoesnotexist.com/" alt="Profile Picture">
                        </div>
                        <h1 class="username">{{ searchUsername || 'Loading...' }}</h1>
                        <span class="user-id-badge" v-if="searchUserId">ID: {{ searchUserId }}</span>
                    </div>

                    <div class="stats-row">
                        <div class="stat-item">
                            <span class="stat-value">3</span>
                            <span class="stat-label">Friends</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-value">5</span>
                            <span class="stat-label">Groups</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-value text-success">Online</span>
                            <span class="stat-label">Status</span>
                        </div>
                    </div>

                    <div class="profile-actions">
                        <div v-if="searchUserId == userId" class="action-group">
                            <button class="btn btn-primary" onclick="window.location.href='/settings'">Edit Profile</button>
                        </div>

                        <div v-else class="action-group">
                            <button class="btn btn-primary">Add Friend</button>
                            <button class="btn btn-outline-primary">Message</button>
                            
                            <div class="danger-actions">
                                <button class="btn btn-danger btn-sm">Report</button>
                                <button class="btn btn-danger btn-sm">Block</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card" style="margin-top: 20px;">
                    <h3>Recent Groups</h3>
                    <p class="text-muted">No recent activity to show.</p>
                </div>

            </main>
        </div>

        <%- include('footer'); -%>
    </div>
</body>
<script src="/static/server.js"></script>
</html>