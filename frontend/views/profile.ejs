</head>

<body>
    <div id="server">
        <%- include('header'); -%>
            <div class="pfp">
                <img src="" alt="">
                <h2>{{ searchUsername }} with User ID: {{ searchUserId }}</h2>
                <button v-if="searchUserId">4</button>
            </div>
            <div style="display: flex; justify-content: center;">
                <div class="block">
                    <h3>Friends</h3>
                    <p>3</p>
                </div>
                <div class="block">
                    <h3>Groups</h3>
                    <p>5</p>
                </div>
                <div class="block">
                    <h3>Status</h3>
                    <p>Online</p>
                </div>
            </div>

            <%- include('footer'); -%>
    </div>
