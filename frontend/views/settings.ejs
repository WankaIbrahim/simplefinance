<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SimpleFinance</title>
  <script src="https://cdn.jsdelivr.net/npm/vue@2/dist/vue.js"></script>
  <link rel="stylesheet" href="/static/main.css">
  <link rel="stylesheet" href="/static/header.css">
  <link rel="stylesheet" href="/static/footer.css">
  <link rel="stylesheet" href="/static/settings.css">
  <!-- <link rel="stylesheet" href="https://cdn.simplecss.org/simple.min.css"> -->
</head>

<body>
  <div id="server">
    <%- include('header') %>
      <main class="settings-page">
        <div class="settings-card">
          <div class="settings-head">
            <h1>Settings</h1>
            <p class="muted">Manage your username, email, password and profile picture</p>
          </div>

          <section class="settings-section">
            <!-- <div class="section-title">
              <h2>Profile Information</h2>
            </div> -->

            <div class="settings-rows">
              <div class="settings-row">
                <div class="info">
                  <label>Display Name</label>
                  <input type="text" v-model="inputUsername">
                </div>
                <div class="info">
                  <label>Email Address</label>
                  <input type="email" v-model="inputEmail">
                </div>
              </div>

              <div class="settings-row">
                <div class="info">
                  <label>Change Password</label>
                  <input type="password" v-model="newPassword" placeholder="New Password">
                </div>
                <div class="info">
                  <label>Profile Picture</label>
                  <div style="display: flex; gap: 10px;">
                    <input type="file" accept="image/*" @change="onPfpSelected" style="width: auto;">
                    <button class="btn btn-sm btn-outline-primary" @click="uploadPfp"
                      :disabled="!pfpFile">Upload</button>
                  </div>
                  <small v-if="pfpStatus" class="text-muted">{{ pfpStatus }}</small>
                </div>
              </div>
            </div>

            <div class="settings-footer"
              style="margin-top: 30px; display: flex; justify-content: space-between; align-items: center;">
              <button class="btn btn-danger" @click="deleteAccount">Delete Account</button>

              <div style="display: flex; gap: 10px; align-items: center;">
                <span v-if="statusMessage" :style="{ color: statusColor }">{{ statusMessage }}</span>
                <button class="btn btn-primary" @click="updateProfile">Save Settings</button>
              </div>
            </div>
          </section>
        </div>
  </div>
  </main>
  </div>
  <%- include('footer') %>
</body>
<script src="/static/server.js"></script>

</html>