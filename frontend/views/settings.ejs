<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SimpleFinance</title>
  <script src="https://cdn.jsdelivr.net/npm/vue@2/dist/vue.js"></script>
  <link rel="stylesheet" href="/static/main.css">
  <link rel="stylesheet" href="/static/header.css">
  <link rel="stylesheet" href="/static/footer.css">
  <link rel="stylesheet" href="/static/settings.css">
  <!-- <link rel="stylesheet" href="https://cdn.simplecss.org/simple.min.css"> -->
</head>

<body>
  <div id="server">
    <%- include('header') %>
      <main class="settings-page">
        <div class="settings-card">
          <div class="settings-head">
            <h1>Settings</h1>
            <p class="muted">Manage your profile, security, and preferences.</p>
          </div>

          <section class="settings-section">
            <div class="section-title">
              <h2>Profile</h2>
              <p class="muted">Basic account information.</p>
            </div>

            <div class="settings-grid">
              <div class="field">
                <label for="name">Name</label>
                <input id="name" type="text" placeholder="John Doe" v-model="inputUsername" />
              </div>

              <div class="field">
                <label for="email">Email</label>
                <input id="email" type="email" placeholder="you@example.com" />
              </div>

              <div class="field">
                <label for="email">Password</label>
                <input id="password" type="text" placeholder="New Password" v-model="newPassword"/>
              </div>
                            <div v-if="statusMessage" class="mt-3 text-center small fw-bold"
                                :style="{ color: statusColor }" style="padding:5px;">
                                {{ statusMessage }}
                            </div>
              <button class="btn btn-secondary" @click="updateProfile">
                Change details
              </button>
            </div>
          </section>


          <hr class="divider" />

          <section class="settings-section">
            <div class="section-title">
              <h2>Preferences</h2>
              <p class="muted">Customize your experience.</p>
            </div>

            <div class="settings-grid">
              <div class="field toggle">
                <label>
                  <input type="checkbox" />
                  <span>Enable notifications</span>
                </label>
              </div>

              <div class="field toggle">
                <label>
                  <input type="checkbox" />
                  <span>Dark mode</span>
                </label>
              </div>
            </div>
          </section>

          <div class="settings-actions">
            <button class="btn btn-primary">
              Save changes
            </button>
            <button class="btn btn-danger">
              Delete account
            </button>
          </div>
        </div>
      </main>
  </div>
  <%- include('footer') %>
</body>
<script src="/static/server.js"></script>

</html>