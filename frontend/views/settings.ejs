<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SimpleFinance</title>
  <script src="https://cdn.jsdelivr.net/npm/vue@2/dist/vue.js"></script>
  <link rel="stylesheet" href="/static/main.css">
  <link rel="stylesheet" href="/static/header.css">
  <link rel="stylesheet" href="/static/footer.css">
  <link rel="stylesheet" href="/static/settings.css">
  <!-- <link rel="stylesheet" href="https://cdn.simplecss.org/simple.min.css"> -->
</head>

<body>
  <div id="server">
    <%- include('header') %>
      <main class="settings-page">
        <div class="settings-card">
          <div class="settings-head">
            <h1>Settings</h1>
            <p class="muted">Manage your username, email, password and profile picture</p>
          </div>

          <section class="settings-section">
            <div class="section-title">
              <h2>Profile</h2>
              <p class="muted">Basic account information.</p>
            </div>

            <div class="settings-grid">
              <div class="field">
                <label for="name">Name</label>
                <input id="name" type="text" placeholder="John Doe" v-model="inputUsername" />
              </div>

              <div class="field">
                <label for="email">Email</label>
                <input id="email" type="email" placeholder="you@example.com" v-model="inputEmail" />
              </div>

              <div class="field">
                <label for="email">Password</label>
                <input id="password" type="text" placeholder="New Password" v-model="newPassword" />
              </div>
              <div v-if="statusMessage" class="mt-3 text-center small fw-bold" :style="{ color: statusColor }"
                style="padding:5px;">
                {{ statusMessage }}
              </div>
              <div style="margin-top:12px; display:flex; flex-direction:column; gap:8px; align-items:flex-start;">
                <input type="file" accept="image/*" @change="onPfpSelected" />
                <button class="btn btn-outline-primary" @click="uploadPfp" :disabled="!pfpFile">
                    Update user PFP
                </button>
                <p v-if="pfpStatus" class="text-muted" style="margin:0;">{{ pfpStatus }}</p>
            </div>
              <button class="btn btn-secondary" @click="updateProfile">
                Change details
              </button>
            </div>
          </section>


          <!-- <hr class="divider" /> -->
          <!-- Commenting this because we are not using it -->
          <!-- <section class="settings-section">
            <div class="section-title">
              <h2>Preferences</h2>
              <p class="muted">Customize your experience.</p>
            </div>

            <div class="settings-grid">
              <div class="field toggle">
                <label>
                  <input type="checkbox" />
                  <span>Enable notifications</span>
                </label>
              </div>

              <div class="field toggle">
                <label>
                  <input type="checkbox" />
                  <span>Dark mode</span>
                </label>
              </div>
            </div>
          </section> -->

          <div class="settings-actions">
            <button class="btn btn-primary">
              Save changes
            </button>
            <button class="btn btn-danger">
              Delete account
            </button>
          </div>
        </div>
      </main>
  </div>
  <%- include('footer') %>
</body>
<script src="/static/server.js"></script>

</html>