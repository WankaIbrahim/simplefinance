<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SimpleFinance - Group View</title>
    <script src="https://cdn.jsdelivr.net/npm/vue@2/dist/vue.js"></script>
    <link rel="icon" type="image/x-icon" href="./favicon.ico">
    <link rel="stylesheet" href="/static/main.css">
    <link rel="stylesheet" href="/static/header.css">
    <link rel="stylesheet" href="/static/footer.css">
    <link rel="stylesheet" href="/static/group-view.css">
</head>

<body>
    <div id="server">
        <%- include('header'); -%>

            <div v-if="groupNotFound" class="app-layout" style="justify-content: center;">
                <div class="card" style="text-align: center; padding: 50px;">
                    <h1>404</h1>
                    <h2>Group Not Found</h2>
                    <p>The group you are looking for does not exist or you do not have permission</p>
                    <a href="/display" class="btn btn-primary" style="margin-top: 20px;">Go back to Dashboard</a>
                </div>
            </div>

            <div v-else-if="activeGroup" class="app-layout">

                <main class="content">
                    <div class="sidebar-overlay" :class="{ 'active': leftSidebarOpen || rightSidebarOpen }"
                        @click="closeSidebars">
                    </div>
                    <div style="text-align: right; margin-bottom: 10px;" v-if="windowWidth <= 900">
                        <button @click="rightSidebarOpen = !rightSidebarOpen" class="btn btn-sm">View Members
                            &lt;</button>
                    </div>
                    <div class="group-header">
                        <h1>{{activeGroup.name}}</h1>
                        <p class="description" style="color:black">{{ activeGroup.description || "No description" }}</p>
                    </div>

                    <div v-if="isCurrentUserAdmin" class="admin-toolbar card">
                        <h3>Admin Controls</h3>
                        <div class="toolbar-actions">
                            <button class="btn btn-outline-primary" @click="showExpenseModal = true">Add
                                Expense</button> <button class="btn btn-outline-primary"
                                @click="openGroupSettings">Group Settings</button>
                                <button class="btn btn-outline-primary" @click="openInviteModal">Invite Member</button>
                            <button class="btn btn-danger" @click="deleteGroup">Delete Group</button>
                        </div>
                    </div>

                    <div v-else class="card" style="margin-bottom: 20px;">
                        <button class="btn btn-danger" @click="leaveGroup">Leave Group</button>
                    </div>


                    <div class="modal-overlay" v-if="showGroupSettingsModal"
                        @mousedown.self="showGroupSettingsModal = false">
                        <div class="modal-card" style="max-width: 700px;">
                            <div class="modal-header">
                                <h2>Group Settings</h2>
                                <button class="close-btn" @click="showGroupSettingsModal = false">&times;</button>
                            </div>

                            <div class="modal-body">
                                <h3>General</h3>
                                <div class="form-group">
                                    <label>Group Name</label>
                                    <input type="text" v-model="editGroupData.name">
                                </div>
                                <div class="form-group">
                                    <label>Description</label>
                                    <textarea v-model="editGroupData.description" rows="2"></textarea>
                                </div>
                                <div class="form-group">
                                    <label>Total Budget</label>
                                    <input type="number" v-model="editGroupData.budget">
                                </div>

                                <hr>

                                <h3>Manage Members</h3>
                                <div class="member-list-settings">
                                    <div v-for="member in [...(activeGroup.admins||[]), ...(activeGroup.users||[]), ...(activeGroup.guests||[])]"
                                        class="member-row-settings">

                                        <span class="member-name">{{ member.username }}</span>

                                        <div class="member-actions">
                                            <select @change="changeMemberRole(member, $event.target.value)">
                                                <option value="" disabled selected>Change Role</option>
                                                <option value="admins">Make Admin</option>
                                                <option value="users">Make Member</option>
                                                <option value="guests">Make Guest</option>
                                            </select>

                                            <button class="btn-xs btn-danger"
                                                @click="removeMember(member)">Remove</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="modal-footer">
                                <button class="btn btn-secondary"
                                    @click="showGroupSettingsModal = false">Cancel</button>
                                <button class="btn btn-success" @click="saveGroupSettings">Save Changes</button>
                            </div>
                        </div>
                    </div>

                    <div class="budget-section card">
                        <div class="budget-header">
                            <h3>Shared Expenses</h3>
                            <span class="budget-numbers">
                                £{{ activeGroup.items.reduce((total, item) => total + (item.price * item.quantity),
                                0).toFixed(2) }}
                                <span class="text-muted">/ £{{ activeGroup.budget }}</span>
                            </span>
                        </div>
                        <div class="progress-bar-container">
                            <div class="progress-bar-fill"
                                :style="{ width: (activeGroup.items.reduce((total, item) => total + (item.price * item.quantity), 0) / activeGroup.budget * 100) + '%' }">
                            </div>
                        </div>
                    </div>

                    <div class="card" style="margin-top: 20px; padding: 0;">
                        <table class="expense-table">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th>Price</th>
                                    <th>Buyer</th>
                                    <th>Qty</th>
                                    <th>Total</th>
                                    <th>Votes</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="expense in activeGroup.items" :key="expense.id" :class="{ 'purchased-row': expense.purchased }">
                                    <td>
                                        <div style="display:flex; align-items:center; gap:10px;">
                                             <input type="checkbox" 
                                                    :checked="expense.purchased" 
                                                    @change="togglePurchased(expense)"
                                                    style="width:18px; height:18px; cursor:pointer;">
                                             <span>{{ expense.name }}</span>
                                        </div>
                                    </td>
                                    <td class="price">£{{ expense.price }}</td>
                                    <td>
                                        <span v-if="expense.buyer" class="badge">{{ expense.buyer.username ||
                                            expense.buyer }}</span>
                                        <span v-else class="text-muted">-</span>
                                    </td>
                                    <td>{{ expense.quantity }}</td>
                                    <td class="price">£{{ (expense.price * expense.quantity).toFixed(2) }}</td>
                                    <td>{{ expense.voted ? expense.voted.length : 0 }}</td>
                                    <td>
                                        <button @click="upvote(expense)" class="btn-icon upvote"
                                            v-if="!expense.voted || !expense.voted.includes(inputUsername)">
                                            ▲
                                        </button>
                                        <button @click="downvote(expense)" class="btn-icon downvote" v-else>
                                            ▼
                                        </button>
                                    </td>
                                </tr>
                                <tr v-if="activeGroup.items.length === 0">
                                    <td colspan="7" style="text-align: center; padding: 20px; color: #777;">
                                        No expenses yet. Add one below!
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <button class="btn-add-row" @click="showExpenseModal = true">
                            + Add New Expense
                        </button>
                    </div>
                </main>

                <aside class="sidebar-right" :class="{ 'open': rightSidebarOpen }">
                    <div class="card">
                        <h3>Group Members</h3>

                        <div class="member-category">
                            <h4>Admins</h4>
                            <ul>
                                <li v-for="member in activeGroup.admins" :key="member.id">
                                    <a :href="'/profile?userId=' + member.id" class="user-link">
                                        <span class="status-dot admin"></span> {{ member.username }}
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <div class="member-category" v-if="activeGroup.users && activeGroup.users.length > 0">
                            <h4>Members</h4>
                            <ul>
                                <li v-for="member in activeGroup.users" :key="member.id">
                                    <a :href="'/profile?userId=' + member.id" class="user-link">
                                        <span class="status-dot member"></span> {{ member.username }}
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <div class="member-category" v-if="activeGroup.guests && activeGroup.guests.length > 0">
                            <h4>Guests</h4>
                            <ul>
                                <li v-for="member in activeGroup.guests" :key="member.id">
                                    <a :href="'/profile?userId=' + member.id" class="user-link">
                                        <span class="status-dot guest"></span> {{ member.username }}
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </aside>
            </div>

            <div v-else class="app-layout" style="justify-content: center;">
                <img src="https://upload.wikimedia.org/wikipedia/commons/b/b1/Loading_icon.gif" alt="Loading"
                    style="width: 50px;">
            </div>
            <!-- Invite Member Modal -->
            <div class="modal-overlay" v-if="showInviteModal" @click.self="closeInviteModal">
            <div class="modal-card" style="max-width: 520px;">
                <div class="modal-header">
                <h2>Invite Member</h2>
                <button class="close-btn" @click="closeInviteModal">&times;</button>
                </div>

                <div class="modal-body">
                <div class="form-group">
                    <label>Username or Email</label>
                    <input type="text"
                        v-model.trim="inviteIdentifier"
                        placeholder="e.g. husam3 or husam@email.com"
                        @keyup.enter="sendInvite" />
                </div>

                <p v-if="inviteStatusMessage" class="small fw-bold" :style="{ color: inviteStatusColor }">
                    {{ inviteStatusMessage }}
                </p>
                </div>

                <div class="modal-footer">
                <button class="btn btn-secondary" @click="closeInviteModal">Cancel</button>
                <button class="btn btn-success" :disabled="inviteSending || !inviteIdentifier" @click="sendInvite">
                    {{ inviteSending ? "Sending..." : "Send Invite" }}
                </button>
                </div>
            </div>
            </div>

            <div class="modal-overlay" v-if="showExpenseModal" @click.self="showExpenseModal = false">
                <div class="modal-card">
                    <h2>Add New Expense</h2>
                    <div class="form-group">
                        <label>Description</label>
                        <input type="text" v-model="item" placeholder="e.g. Chair">
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Price (£)</label>
                            <input type="number" v-model="price" step="0.01">
                        </div>
                        <div class="form-group">
                            <label>Quantity</label>
                            <input type="number" v-model="quantity" step="1">
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Who paid?</label>
                        <select v-model="buyer">
                            <option v-for="member in activeGroup.admins" :value="member.username">{{ member.username }}
                            </option>
                            <option v-for="member in activeGroup.users" :value="member.username">{{ member.username }}
                            </option>
                        </select>
                    </div>
                    <div class="modal-actions">
                        <button @click="newExpense(); showExpenseModal = false;" class="btn btn-success">Add
                            Item</button>
                        <button @click="showExpenseModal = false" class="btn btn-danger">Cancel</button>
                    </div>
                </div>
            </div>

            <%- include('footer'); -%>
    </div>
</body>
<script src="/static/server.js"></script>

</html>