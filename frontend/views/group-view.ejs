<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SimpleFinance - Group View</title>
    <script src="https://cdn.jsdelivr.net/npm/vue@2/dist/vue.js"></script>
    <link rel="icon" type="image/x-icon" href="./favicon.ico">
    <link rel="stylesheet" href="/static/main.css">
    <link rel="stylesheet" href="/static/header.css">
    <link rel="stylesheet" href="/static/footer.css">
    <link rel="stylesheet" href="/static/group-view.css">
</head>

<body>
    <div id="server">
        <%- include('header'); -%>

            <div v-if="groupNotFound" class="app-layout" style="justify-content: center;">
                <div class="card" style="text-align: center; padding: 50px;">
                    <h1>404</h1>
                    <h2>Group Not Found</h2>
                    <p>The group you are looking for does not exist or you do not have permission</p>
                    <a href="/display" class="btn btn-primary" style="margin-top: 20px;">Go back to Dashboard</a>
                </div>
            </div>

            <div v-else-if="activeGroup" class="app-layout">

                <main class="content">
                    <div class="sidebar-overlay" :class="{ 'active': leftSidebarOpen || rightSidebarOpen }"
                        @click="closeSidebars">
                    </div>
                    <div style="text-align: right; margin-bottom: 10px;" v-if="windowWidth <= 900">
                        <button @click="rightSidebarOpen = !rightSidebarOpen" class="btn btn-sm">View Members
                            &lt;</button>
                    </div>
                    <div class="group-header">
                        <h1>{{activeGroup.name}}</h1>
                        <p class="description">{{ activeGroup.description || "No description" }}</p>
                    </div>

                    <div v-if="isCurrentUserAdmin" class="admin-toolbar card">
                        <h3>Admin Controls</h3>
                        <div class="toolbar-actions">
                            <button class="btn btn-outline-primary" @click="showExpenseModal = true">Add
                                Expense</button> <button class="btn btn-outline-primary"
                                @click="openGroupSettings">Group Settings</button>
                            <button class="btn btn-outline-primary" @click="openInviteModal">Invite Member</button>
                            <button class="btn btn-outline-primary" @click="exportCSV">Export CSV</button>
                            <button class="btn btn-outline-primary" @click="exportExcel">Export Excel</button>

                            <button class="btn btn-danger" @click="deleteGroup">Delete Group</button>
                        </div>
                    </div>

                    <div v-else class="card" style="margin-bottom: 20px;">
                        <button class="btn btn-danger" @click="leaveGroup">Leave Group</button>
                    </div>


                    <div class="modal-overlay" v-if="showGroupSettingsModal"
                        @mousedown.self="showGroupSettingsModal = false">
                        <div class="modal-card" style="max-width: 700px;">
                            <div class="modal-header">
                                <h2>Group Settings</h2>
                                <button class="close-btn" @click="showGroupSettingsModal = false">&times;</button>
                            </div>

                            <div class="modal-body">
                                <h3>General</h3>
                                <div class="form-group">
                                    <label>Group Name</label>
                                    <input type="text" v-model="editGroupData.name">
                                </div>
                                <div class="form-group">
                                    <label>Description</label>
                                    <textarea v-model="editGroupData.description" rows="2"></textarea>
                                </div>
                                <div class="form-group">
                                    <label>Total Budget</label>
                                    <input type="number" v-model="editGroupData.budget">
                                </div>

                                <hr>

                                <h3>Manage Members</h3>
                                <div class="member-list-settings">
                                    <div v-for="member in [...(activeGroup.admins||[]), ...(activeGroup.users||[]), ...(activeGroup.guests||[])]"
                                        class="member-row-settings">

                                        <span class="member-name">{{ member.username }}</span>

                                        <div class="member-actions">
                                            <select @change="changeMemberRole(member, $event.target.value)">
                                                <option value="" disabled selected>Change Role</option>
                                                <option value="admins">Make Admin</option>
                                                <option value="users">Make Member</option>
                                                <option value="guests">Make Guest</option>
                                            </select>

                                            <button class="btn-xs btn-danger"
                                                @click="removeMember(member)">Remove</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="modal-footer">
                                <button class="btn btn-secondary"
                                    @click="showGroupSettingsModal = false">Cancel</button>
                                <button class="btn btn-success" @click="saveGroupSettings">Save Changes</button>
                            </div>
                        </div>
                    </div>

                    <div class="budget-section card">
                        <div class="budget-header">
                            <h3>Shared Expenses</h3>
                            <span class="budget-numbers">
                                £{{ activeGroup.items.reduce((total, item) => total + (item.price * item.quantity),
                                0).toFixed(2) }}
                                <span class="text-muted">/ £{{ activeGroup.budget }}</span>
                            </span>
                        </div>
                        <div class="progress-bar-container">
                            <div class="progress-bar-fill"
                                :style="{ width: (activeGroup.items.reduce((total, item) => total + (item.price * item.quantity), 0) / activeGroup.budget * 100) + '%' }">
                            </div>
                        </div>
                    </div>

                    <div class="card" style="margin-top: 20px; padding: 0;">
                        <table class="expense-table">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th>Price</th>
                                    <th>Buyer</th>
                                    <th>Qty</th>
                                    <th>Link</th>
                                    <th>Total</th>
                                    <th>Votes</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="expense in sortedGroupItems" :key="expense.id"
                                    :class="{ 'purchased-row': expense.purchased }">
                                    <td>
                                        <div style="display:flex; align-items:center; gap:10px;">
                                            <input type="checkbox" :checked="expense.purchased"
                                                @change="togglePurchased(expense)"
                                                style="width:18px; height:18px; cursor:pointer;">
                                            <span>{{ expense.name }}</span>
                                        </div>
                                    </td>
                                    <td class="price">£{{ (expense.price).toFixed(2) }}</td>
                                    <td>
                                        <span v-if="expense.buyer" class="badge">{{ expense.buyer.username ||
                                            expense.buyer }}</span>
                                        <span v-else class="text-muted">-</span>
                                    </td>
                                    <td>{{ expense.quantity }}</td>
                                    <td v-if="expense.url">
                                        <a :href="expense.url" target="_blank">Website</a>
                                    </td>
                                    <td v-else>-</td>
                                    <td class="price">£{{ (expense.price * expense.quantity).toFixed(2) }}</td>
                                    <td>{{ expense.voted ? expense.voted.length : 0 }}</td>
                                    <td>
                                        <div style="display: flex; gap: 5px;">
                                            <button @click="upvote(expense)" class="btn-icon upvote"
                                                title="Upvote">▲</button>
                                            <button @click="downvote(expense)" class="btn-icon downvote"
                                                title="Downvote">▼</button>
                                        </div>

                                        <div style="margin-top: 5px;">
                                            <button @click="toggleActionMenu(expense)" class="btn-xs"
                                                style="background:none; border:none; color:var(--text-muted); cursor:pointer; font-size: 0.8rem;">
                                                More...
                                            </button>

                                            <div v-if="expense.showActions"
                                                style="position: absolute; background: var(--bg-card); border: 1px solid var(--border); padding: 10px; border-radius: 8px; z-index: 10; box-shadow: 0 4px 10px rgba(0,0,0,0.3);">
                                                <label style="display:block; margin-bottom:8px; cursor:pointer;">
                                                    <input type="checkbox" :checked="expense.priority"
                                                        @change="prioritiseExpense(expense)"> Prioritize
                                                </label>
                                                <div style="height: 1px; background: var(--border); margin: 5px 0;">
                                                </div>
                                                <button @click="openEditExpense(expense)"
                                                    style="display:block; width:100%; text-align:left; background:none; border:none; color: var(--text-main); padding: 5px; cursor: pointer;">Edit</button>
                                                <button @click="confirmRemoveExpense(expense)"
                                                    style="display:block; width:100%; text-align:left; background:none; border:none; color: var(--text-danger); padding: 5px; cursor: pointer;">Delete</button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                <tr v-if="activeGroup.items.length === 0">
                                    <td colspan="7" style="text-align: center; padding: 20px; color: #777;">
                                        No expenses yet. Add one below!
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <button class="btn-add-row" @click="showExpenseModal = true">+ Add New Expense</button>
                        <button class="btn-add-row"
                            style="margin-top: 10px; background: linear-gradient(45deg, #FFD700, #ffecb3); color: black;"
                            @click="showAiGroupModal = true">
                            ✨ Let Bard AI Suggest Items ✨
                        </button>

                        <div class="modal-overlay" v-if="showInviteModal" @click.self="closeInviteModal">
                            <div class="modal-card">
                                <div class="modal-header">
                                    <h2>Invite Members</h2>
                                    <button class="close-btn" @click="closeInviteModal">&times;</button>
                                </div>
                                <div class="modal-body">
                                    <input 
                                        type="text" 
                                        v-model="inviteSearchQuery" 
                                        @input="searchInviteUsers" 
                                        placeholder="Search by username..." 
                                        class="form-control" 
                                        style="margin-bottom: 15px;"
                                    >
                                    
                                    <div class="invite-results" style="max-height: 300px; overflow-y: auto;">
                                        <div 
                                            v-for="u in inviteSearchResults" 
                                            :key="u.id" 
                                            style="display: flex; justify-content: space-between; align-items: center; padding: 10px; border-bottom: 1px solid #eee;"
                                        >
                                            <div style="display: flex; align-items: center; gap: 10px;">
                                                <img 
                                                    v-if="u.pfpUrl" 
                                                    :src="u.pfpUrl" 
                                                    style="width: 30px; height: 30px; border-radius: 50%; object-fit: cover;"
                                                >
                                                <div>
                                                    <span style="font-weight: bold;">{{ u.username }}</span>
                                                    <div v-if="u.email" style="font-size: 0.85em; color: #666;">{{ u.email }}</div>
                                                </div>
                                            </div>
                                            <div style="display: flex; gap: 5px; align-items: center;">
                                                <select 
                                                    v-model="inviteUserStates[u.id].role" 
                                                    style="padding: 5px;" 
                                                    class="form-control"
                                                    :disabled="inviteUserStates[u.id].sending"
                                                >
                                                    <option value="users">Member</option>
                                                    <option value="admins">Admin</option>
                                                    <option value="guests">Guest</option>
                                                </select>
                                                <button 
                                                    class="btn btn-sm btn-success" 
                                                    @click="inviteUser(u)" 
                                                    :disabled="inviteUserStates[u.id].sending"
                                                >
                                                    {{ inviteUserStates[u.id].sending ? 'Adding...' : 'Add' }}
                                                </button>
                                            </div>
                                        </div>
                                        <p 
                                            v-if="inviteSearchQuery.length > 1 && inviteSearchResults.length === 0" 
                                            class="text-muted"
                                            style="text-align: center; padding: 20px;"
                                        >
                                            No users found.
                                        </p>
                                        <p 
                                            v-if="inviteSearchQuery.length > 0 && inviteSearchQuery.length < 2" 
                                            class="text-muted"
                                            style="text-align: center; padding: 20px;"
                                        >
                                            Type at least 2 characters to search...
                                        </p>
                                    </div>
                                    <p 
                                        v-if="inviteStatusMessage" 
                                        :style="{color: inviteStatusColor, marginTop: '10px', fontWeight: 'bold'}"
                                    >
                                        {{ inviteStatusMessage }}
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="modal-overlay" v-if="showAiGroupModal" @click.self="showAiGroupModal = false">
                            <div class="modal-card">
                                <h2>AI Item Assistant</h2>
                                <div v-if="!aiLoading">
                                    <input type="text" v-model="aiGroupIdea"
                                        placeholder="What do you need items for? (e.g. BBQ)">
                                    <div class="form-row">
                                        <input type="number" v-model="aiGroupPeople" placeholder="People">
                                        <input type="number" v-model="aiGroupBudget" placeholder="Budget">
                                    </div>
                                    <textarea v-model="aiGroupNotes" placeholder="Notes..."></textarea>
                                    <button class="btn btn-primary" style="width: 100%; margin-top: 10px;"
                                        @click="getAiItemsForGroup">Generate</button>
                                </div>
                                <div v-else style="text-align: center; padding: 20px;">
                                    <p>Generating...</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>

                <aside class="sidebar-right" :class="{ 'open': rightSidebarOpen }">
                    <div class="card">
                        <h3>Group Members</h3>

                        <div class="member-category">
                            <h4>Admins</h4>
                            <ul>
                                <li v-for="member in activeGroup.admins" :key="member.id">
                                    <a :href="'/profile?userId=' + member.id" class="user-link">
                                        <span class="status-dot admin"></span> {{ member.username }}
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <div class="member-category" v-if="activeGroup.users && activeGroup.users.length > 0">
                            <h4>Members</h4>
                            <ul>
                                <li v-for="member in activeGroup.users" :key="member.id">
                                    <a :href="'/profile?userId=' + member.id" class="user-link">
                                        <span class="status-dot member"></span> {{ member.username }}
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <div class="member-category" v-if="activeGroup.guests && activeGroup.guests.length > 0">
                            <h4>Guests</h4>
                            <ul>
                                <li v-for="member in activeGroup.guests" :key="member.id">
                                    <a :href="'/profile?userId=' + member.id" class="user-link">
                                        <span class="status-dot guest"></span> {{ member.username }}
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </aside>
            </div>

            <div v-else class="app-layout" style="justify-content: center;">
                <img src="https://upload.wikimedia.org/wikipedia/commons/b/b1/Loading_icon.gif" alt="Loading"
                    style="width: 50px;">
            </div>

            <div class="modal-overlay" v-if="showRemoveConfirm" @click.self="closeRemoveConfirm">
                <div class="modal-card" style="max-width: 520px;">
                    <div class="modal-header">
                        <h2>Remove item?</h2>
                        <button class="close-btn" @click="closeRemoveConfirm">&times;</button>
                    </div>

                    <div class="modal-body">
                        <p>Remove <strong>{{ selectedExpense && selectedExpense.name }}</strong> from the list?</p>
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-secondary" @click="closeRemoveConfirm">Cancel</button>
                        <button class="btn btn-danger" @click="removeSelectedExpense">Remove</button>
                    </div>
                </div>
            </div>

            <div class="modal-overlay" v-if="showEditExpenseModal" @click.self="closeEditExpense">
                <div class="modal-card" style="max-width: 700px;">
                    <div class="modal-header">
                        <h2>Update item details</h2>
                        <button class="close-btn" @click="closeEditExpense">&times;</button>
                    </div>

                    <div class="modal-body">
                        <div class="form-group">
                            <label>Description</label>
                            <input type="text" v-model.trim="editExpenseData.name">
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Price (£)</label>
                                <input type="number" v-model.number="editExpenseData.price" step="0.01">
                            </div>
                            <div class="form-group">
                                <label>Quantity</label>
                                <input type="number" v-model.number="editExpenseData.quantity" step="1" min="1">
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Buyer</label>
                            <select v-model="editExpenseData.buyerUsername">
                                <option value="">-</option>
                                <option v-for="m in [...(activeGroup.admins||[]), ...(activeGroup.users||[])]"
                                    :value="m.username">
                                    {{ m.username }}
                                </option>
                            </select>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-secondary" @click="closeEditExpense">Cancel</button>
                        <button class="btn btn-success" @click="saveEditExpense">Save</button>
                    </div>
                </div>
            </div>

            <div class="modal-overlay" v-if="showExpenseModal" @click.self="showExpenseModal = false">
                <div class="modal-card">
                    <h2>Add New Expense</h2>
                    <div class="form-group">
                        <label>Description</label>
                        <input type="text" v-model="item" placeholder="e.g. Chair">
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Price (£)</label>
                            <input type="number" v-model="price" step="0.01">
                        </div>
                        <div class="form-group">
                            <label>Quantity</label>
                            <input type="number" v-model="quantity" step="1">
                        </div>
                    </div>
                    <div class="form-row">

                        <div class="form-group">
                            <label>Link</label>
                            <input type="text" v-model="url">
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Who paid?</label>
                        <select v-model="payer">
                            <option v-for="member in activeGroup.admins" :value="member.username">{{ member.username }}
                            </option>
                            <option v-for="member in activeGroup.users" :value="member.username">{{ member.username }}
                            </option>
                        </select>
                    </div>
                    <div class="modal-actions">
                        <button @click="newExpense(); showExpenseModal = false;" class="btn btn-success">Add
                            Item</button>
                        <button @click="showExpenseModal = false" class="btn btn-danger">Cancel</button>
                    </div>
                </div>
            </div>

            <%- include('footer'); -%>
    </div>
</body>
<script src="/static/server.js"></script>

</html>