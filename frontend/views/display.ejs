<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SimpleFinance</title>
    <script src="https://cdn.jsdelivr.net/npm/vue@2/dist/vue.js"></script>
    <link rel="stylesheet" href="/static/main.css">
    <link rel="stylesheet" href="/static/header.css">
    <link rel="stylesheet" href="/static/footer.css">
    <!-- <link rel="stylesheet" href="https://cdn.simplecss.org/simple.min.css"> -->
    <link rel="icon" type="image/x-icon" href="./favicon.ico">

    <!-- <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css"> -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
</head>

<body>
    <div id="server">

        <%- include('header'); -%>
            <div class="app-layout">
                <aside class="sidebar-left">
                    <h3>Menu</h3>
                    <p>Welcome, {{ inputUsername }}</p>
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/settings">Settings</a></li>
                    </ul>
                </aside>

                <main class="content" style="display:block; justify-content: center;">

                    <div class="login" v-if="!loggedIn" style="display: grid;
                                         place-items: center;
                                         text-align: center;">

                        <div class="card-header bg-primary text-white text-center">
                            <h2 class="mb-0">SimpleFinance</h2>
                        </div>
                        <div class="card-body p-4 gap-10">
                            <h5 class="text-center mb-4 text-muted ">User Credentials</h5>
                            <div class="mb-3">
                                <input type="text" v-model="inputUsername" class="form-control" placeholder="Username">
                            </div>
                            <div class="mb-3">
                                <input type="password" v-model="inputPassword" class="form-control"
                                    placeholder="Password" @keyup.enter="login">
                            </div>
                            <div v-if="statusMessage" class="mt-3 text-center small fw-bold"
                                :style="{ color: statusColor }" style="padding:5px;">
                                {{ statusMessage }}
                            </div>
                            <div class="d-flex gap-10">
                                <button @click="login" class="btn btn-success flex-fill" style="width: 100%;">Sign
                                    in</button>
                                <button @click="register" class="btn btn-outline-primary flex-fill"
                                    style="width: 100%;">Sign
                                    up</button>
                            </div>

                        </div>
                    </div>

                    <div v-else>


                        <p>Hello {{inputUsername}}, ready to make budgets?</p>
                        <hr>
                        <!-- <aside>
                    <h2>Friends</h2>
                </aside> -->
                        <div class="spending-groups" style="display:grid">
                            <div class="personal-groups">
                                <h2>Personal Groups</h2>
                                <div class="row">

                                    <div class="element" v-for="group in myGroups" :key="group.id"
                                        style="border: 5px solid black;">
                                        <a :href="'/group-view?groupId=' + group.id" class="fill-div">{{ group.name }}</a>
                                    </div>
                                    <div class="element">
                                        <div v-if="myGroups.length === 0" style="text-align: center;">
                                            <p>Create your first group!</p>
                                        </div>
                                        <div v-else style="text-align: center;">
                                            <p>Create a new group!</p>
                                        </div>
                                        <div style="font-size:2.5em; 
                                            display: flex;
                                            flex-direction: column;
                                            align-items: center;
                                            justify-content: center;
                                            width: 100px;
                                            height: 100px;
                                            border: 3px dashed black; 
                                            border-radius: 50px; 
                                            margin: 5px;
                                            ">
                                            +
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <hr>

                            <div class="other-groups">
                                <h2>Other Groups</h2>
                                <div class="row">

                                    <div class="element" v-for="group in membershipGroups" :key="group.id"
                                        style="border: 5px solid black;">
                                        <a :href="'/group-view?groupId=' + group.id" class="fill-div">{{ group.name }}</a>
                                    </div>
                                    <div class="element">
                                        <p>Join other groups!</p>
                                        <div style="font-size:2.5em; 
                                            display: flex;
                                            flex-direction: column;
                                            align-items: center;
                                            justify-content: center;
                                            width: 100px;
                                            height: 100px;
                                            border: 3px dashed black; 
                                            border-radius: 50px; 
                                            margin: 5px;
                                            ">
                                            +
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <hr>

                            <div class="examples">
                                <h2>Popular Templates</h2>
                                <div class="row">
                                    <div class="element">
                                        <p>Groceries</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
                <aside class="sidebar-right">
                    <div class="card">
                        <h3>Announcements</h3>
                        <p>Happy Christmas</p>
                    </div>
                    <div class="card">
                        <h3>Online Friends</h3>
                        <ul>
                            <li>Alice</li>
                            <li>Bob</li>
                        </ul>
                    </div>
                </aside>

            </div>
    </div>
    <%- include('footer'); -%>
</body>


<script src="/static/server.js"></script>

</html>