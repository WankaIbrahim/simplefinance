<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SimpleFinance</title>
    <script src="https://cdn.jsdelivr.net/npm/vue@2/dist/vue.js"></script>
    <link rel="stylesheet" href="/static/main.css">
    <link rel="stylesheet" href="/static/display.css">
    <link rel="stylesheet" href="/static/header.css">
    <link rel="stylesheet" href="/static/footer.css">
    <link rel="icon" type="image/x-icon" href="./favicon.ico">
</head>

<body>
    <div id="server">

        <%- include('header'); -%>

            <div class="app-layout">
                <div class="sidebar-overlay" :class="{ 'active': leftSidebarOpen || rightSidebarOpen }"
                    @click="closeSidebars">
                </div>
                <aside class="sidebar-left" v-if="loggedIn" :class="{ 'open': leftSidebarOpen }">
                    <h3>Menu</h3>
                    <p>Welcome, {{ inputUsername }}</p>
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/settings">Settings</a></li>
                    </ul>
                </aside>

                <main class="content" style="display:block; justify-content: center;">
                    <div class="login" v-if="!loggedIn" style="display: grid;
                                         place-items: center;
                                         text-align: center;">

                        <div class="card-header bg-primary text-white text-center">
                            <h2 class="mb-0">SimpleFinance</h2>
                        </div>
                        <div class="card-body p-4 gap-10">
                            <h5 class="text-center mb-4 text-muted ">User Credentials</h5>
                            <div class="mb-3">
                                <input type="text" v-model="inputUsername" class="form-control" placeholder="Username">
                            </div>
                            <div class="mb-3">
                                <input type="password" v-model="inputPassword" class="form-control"
                                    placeholder="Password" @keyup.enter="login">
                            </div>
                            <div v-if="statusMessage" class="mt-3 text-center small fw-bold"
                                :style="{ color: statusColor }" style="padding:5px;">
                                {{ statusMessage }}
                            </div>
                            <div class="d-flex gap-10">
                                <button @click="login" class="btn btn-success flex-fill" style="width: 100%;">Sign
                                    in</button>
                                <button @click="register" class="btn btn-outline-primary flex-fill"
                                    style="width: 100%;">Sign
                                    up</button>
                            </div>

                        </div>
                    </div>

                    <div v-else>
                        <div v-if="windowWidth <= 900"
                            style="display:flex; justify-content:space-between; margin-bottom:15px;">
                            <button @click="leftSidebarOpen = true" class="btn">Menu &gt;</button>
                            <button @click="rightSidebarOpen = true" class="btn">&lt; Social</button>
                        </div>

                        <p>Hello {{inputUsername}}, ready to make budgets?</p>
        
                        
                        <hr>
                        <div class="spending-groups" style="display:grid; color: black">
                            <div class="personal-groups">
                                <h2>Personal Groups</h2>
                                <div class="row">

                                    <div class="element" v-for="group in myGroups" :key="group.id"
                                        style="border: 5px solid black;">
                                        <a :href="'/group-view?groupId=' + group.id" class="fill-div">{{ group.name
                                            }}</a>
                                    </div>

                                    <div class="element" @click="openCreateGroupModal">
                                        <div v-if="myGroups.length === 0" style="text-align: center;">
                                            <p>Create your first group!</p>
                                        </div>
                                        <div v-else style="text-align: center;">
                                            <p>Create a new group!</p>
                                        </div>
                                        <div class="plus-icon"> + </div>
                                    </div>
                                    <div class="element ai-element" @click="openAiModal">
                                        <div style="text-align: center;">
                                            <p>Ask Bard to create a group</p>
                                        </div>
                                        <div class="plus-icon" style="border-color: var(--accent);">AI</div>
                                    </div>
                                    
                                    
                                    <div class="modal-overlay" v-if="showAiModal" @mousedown.self="showAiModal = false">
                                        <div class="modal-card">
                                            <div class="modal-header">
                                                <h2>Bard - your personal budget organiser</h2>
                                                <button class="close-btn" @click="showAiModal = false">&times;</button>
                                            </div>
                                            
                                            <div class="modal-body" v-if="!aiLoading">
                                                <div class="form-group">
                                                    <label>What is the event? (General Idea)</label>
                                                    <input type="text" v-model="aiData.idea" placeholder="e.g. Weekend Camping Trip">
                                                </div>
                                                
                                                <div class="form-row">
                                                    <div class="form-group">
                                                        <label>People Count (Estimate)</label>
                                                        <input type="number" v-model="aiData.people" min="1">
                                                    </div>
                                                    <div class="form-group">
                                                        <label>Rough Budget (£)</label>
                                                        <input type="number" v-model="aiData.budget" min="0">
                                                    </div>
                                                </div>
                                    
                                                <div class="form-group">
                                                    <label>Additional Notes (Dietary, Preferences, etc.)</label>
                                                    <textarea v-model="aiData.notes" rows="3" placeholder="e.g. Vegetarian food only, we need tents..."></textarea>
                                                </div>
                                            </div>
                                    
                                            <div class="modal-body" v-else style="text-align: center; padding: 40px;">
                                                <img src="https://upload.wikimedia.org/wikipedia/commons/b/b1/Loading_icon.gif" style="width: 50px;">
                                                <p>Thinking...</p>
                                            </div>
                                    
                                            <div class="modal-footer" v-if="!aiLoading">
                                                <button class="btn btn-secondary" @click="showAiModal = false">Cancel</button>
                                                <button class="btn btn-primary" @click="generateGroup">Generate ✨</button>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="modal-overlay" v-if="showCreateGroupModal" @mousedown.self="showCreateGroupModal = false">
                                        <div class="modal-card create-group-modal">
                                            <div class="modal-header">
                                                <h2>{{ newGroupItems.length > 0 ? 'Review & Create Group' : 'Create New Group' }}</h2>
                                                <button class="close-btn" @click="showCreateGroupModal = false" style="color:white; font-size:1.5rem; background:none; border:none; cursor:pointer;">&times;</button>
                                            </div>
                                    
                                            <div class="modal-body">
                                                <div class="form-group">
                                                    <label>Group Name</label>
                                                    <input type="text" v-model="newGroup.name" placeholder="e.g. Ski Trip 2026">
                                                </div>
                                                <div class="form-group">
                                                    <label>Description</label>
                                                    <input type="text" v-model="newGroup.description" placeholder="Short description...">
                                                </div>
                                                <div class="form-group">
                                                    <label>Budget (£)</label>
                                                    <input type="number" v-model="newGroup.budget" min="0">
                                                </div>
                                    
                                                <div v-if="newGroupItems.length > 0" style="background: rgba(255, 215, 0, 0.05); padding: 15px; border-radius: 8px; border: 1px solid var(--accent); margin-bottom: 20px;">
                                                    <h4 style="color: var(--accent); margin-bottom: 10px;">✨ AI Suggestions</h4>
                                                    <p class="text-muted" style="font-size: 0.9rem; margin-bottom: 10px;">Review items before creating the group.</p>
                                                    
                                                    <div class="items-list-preview" style="max-height: 200px; overflow-y: auto;">
                                                        <div v-for="(item, idx) in newGroupItems" :key="idx" class="preview-item" 
                                                             style="background: var(--bg-card); display: flex; justify-content: space-between; padding: 10px; margin-bottom: 8px; border-radius: 6px; border: 1px solid var(--border);">
                                                            <div>
                                                                <strong style="color: var(--text-main);">{{ item.name }}</strong>
                                                                <div style="font-size: 0.85rem; color: var(--text-muted);">£{{ item.price }} x {{ item.quantity }}</div>
                                                            </div>
                                                            <button @click="removeNewItem(idx)" style="background: none; border: none; color: var(--text-danger); font-weight: bold; cursor: pointer;">&times;</button>
                                                        </div>
                                                    </div>
                                                </div>
                                    
                                                <hr style="border-color: var(--border);">
                                    
                                                <div class="member-selection">
                                                    <h3>Add Members</h3>
                                                    <div class="search-box">
                                                         <input type="text" v-model="memberSearchQuery" @input="searchMembers" placeholder="Search username...">
                                                         <div class="search-dropdown" v-if="memberSearchResults.length > 0" style="background: var(--bg-card); border-color: var(--border);">
                                                            <div class="search-item" v-for="user in memberSearchResults" :key="user.id" style="border-bottom-color: var(--border);">
                                                                <img :src="user.pfpUrl || '/static/default-avatar.png'" class="avatar-sm">
                                                                <span class="username" style="color: var(--text-main);">{{ user.username }}</span>
                                                                <div class="add-btns">
                                                                    <button class="btn-xs btn-outline-primary" @click="addMember(user, 'admins')">Admin</button>
                                                                    <button class="btn-xs btn-outline-primary" @click="addMember(user, 'users')">User</button>
                                                                    <button class="btn-xs btn-outline-primary" @click="addMember(user, 'guests')">Guest</button>
                                                                </div>
                                                            </div>
                                                         </div>
                                                    </div>
                                                    </div>
                                            </div>
                                    
                                            <div class="modal-footer" style="margin-top: 20px; display: flex; justify-content: flex-end; gap: 10px;">
                                                <button class="btn btn-secondary" @click="showCreateGroupModal = false" style="background: transparent; color: var(--text-muted); border: 1px solid var(--border);">Cancel</button>
                                                <button class="btn btn-success" @click="createGroup">
                                                    {{ newGroupItems.length > 0 ? 'Accept Suggestions & Create' : 'Create Group' }}
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <hr>

                            <div class="other-groups">
                                <h2>Other Groups</h2>
                                <div class="row">

                                    <div class="element" v-for="group in membershipGroups" :key="group.id"
                                        style="border: 5px solid black;">
                                        <a :href="'/group-view?groupId=' + group.id" class="fill-div">{{ group.name
                                            }}</a>
                                    </div>
                                    <div class="element">
                                        <p>Join other groups!</p>
                                        <div style="font-size:2.5em; 
                                            display: flex;
                                            flex-direction: column;
                                            align-items: center;
                                            justify-content: center;
                                            width: 100px;
                                            height: 100px;
                                            border: 3px dashed black; 
                                            border-radius: 50px; 
                                            margin: 5px;
                                            ">
                                            +
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <hr>

                            <div class="examples">
                                <h2>Popular Templates</h2>
                                <div class="row">
                                    <div class="element">
                                        <p>Groceries</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
                <aside class="sidebar-right" v-if="loggedIn" :class="{ 'open': rightSidebarOpen }">

                    <div class="card" v-if="incomingRequests.length > 0" style="margin-bottom: 20px;">
                        <h3>Requests</h3>
                        <ul style="list-style: none; padding: 0;">
                            <li v-for="reqUser in incomingRequests" :key="reqUser"
                                style="margin-bottom: 10px; border-bottom: 1px solid #eee; padding-bottom: 5px;">
                                <div style="font-weight: bold;">{{ reqUser }}</div>
                                <div style="display: flex; gap: 5px; margin-top: 5px;">
                                    <button class="btn btn-success btn-sm"
                                        @click="respondRequest(reqUser, true)">Accept</button>
                                    <button class="btn btn-danger btn-sm"
                                        @click="respondRequest(reqUser, false)">Ignore</button>
                                </div>
                            </li>
                        </ul>
                    </div>

                    <div class="card">
                        <h3>Announcements</h3>
                        <p>Happy Christmas</p>
                    </div>

                    <div class="card">
                        <h3>My Friends</h3>
                        <ul v-if="friends.length > 0">
                            <li v-for="friend in friends" :key="friend">
                                {{ friend }}
                            </li>
                        </ul>
                        <p v-else class="text-muted">No friends yet.</p>
                    </div>
                </aside>

            </div>
    </div>
    <%- include('footer'); -%>
</body>


<script src="/static/server.js"></script>

</html>