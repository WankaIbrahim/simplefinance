<div class="answer-container">

  <div class="answer-card" v-if="audience">
    <h2>Audience Member</h2>
    <p>You can’t answer prompts this round - sit back and enjoy the show!</p>
  </div>

  <div
    class="answer-card"
    v-else-if="gameInfo[3].prompts.length > 0"
  >
    <h2>Answer the prompt</h2>
    <p class="answer-prompt">
      {{ gameInfo[3].prompts[0] }}
    </p>

    <div class="answer-input-row">
      <input
        type="text"
        v-model="ans"
        placeholder="Funny response…"
        @keyup.enter="sendAnswer(gameInfo[3].prompts[0])"
      >
      <button @click="sendAnswer(gameInfo[3].prompts[0])">
        Done
      </button>
    </div>
  </div>

  <div class="answer-card" v-else>
    <h2>Waiting for other players…</h2>
    <p>You’ve answered all your prompts. Waiting for everyone else to finish.</p>
  </div>

</div>
