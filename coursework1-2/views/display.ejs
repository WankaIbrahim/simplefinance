<!doctype html>
<html lang="en">

  <%- include('header'); -%>

  <div id="display" class="display-container">
    <div class="display-card">

      <h1 class="mb-4 text-center">QuipECS</h1>

      <div v-if="gameState == 1">
        <h2>Waiting for players to connect</h2>
        <p>Open <strong>{{ joinUrl }}</strong> on your device to join the game.</p>

        <h3 class="mt-4">Players joined so far:</h3>
        <p v-if="adminName" class="text-muted">
          Admin: <strong>{{ adminName }}</strong>
        </p>

        <ul class="list-unstyled">
          <li v-if="players.length === 0 && audience.length === 0">
            <em>No players yet...</em>
          </li>

          <li
            v-for="player in players"
            :key="'player-' + player"
          >
            {{ player }}
          </li>

          <li
            v-for="aud in audience"
            :key="'aud-' + aud"
          >
            {{ aud }}
            <span class="badge bg-secondary ms-2">Audience</span>
          </li>
        </ul>
      </div>

      <div v-else-if="gameState == 2">
        <h2>Prompt suggestion phase</h2>
        <p>Players and audience are entering prompts on their devices.</p>

        <h3 class="mt-4">Prompts submitted this game:</h3>
        <p>Total prompts: <strong>{{ promptCount }}</strong></p>
        <ul class="list-unstyled">
          <li v-if="promptAuthors.length === 0"><em>No prompts yet...</em></li>
          <li v-for="name in promptAuthors" :key="name">
            {{ name }} has submitted a prompt
          </li>
        </ul>
      </div>

      <div v-else-if="gameState == 3">
        <h2>Answering prompts</h2>
        <p>Players are answering the prompts sent to their devices.</p>

        <h3 class="mt-4">Answer progress</h3>

        <p class="mb-1"><strong>Answered:</strong></p>
        <ul class="list-unstyled">
          <li v-if="answeredPlayers.length === 0"><em>Nobody has answered yet...</em></li>
          <li v-for="name in answeredPlayers" :key="'answered-' + name">
            {{ name }}
          </li>
        </ul>

        <p class="mb-1 mt-3"><strong>Still waiting on:</strong></p>

        <ul v-if="answeredPlayers.length === 0 && waitingPlayers.length === 0" class="list-unstyled">
          <li><em>Waiting for players to start answering...</em></li>
        </ul>

        <ul v-else-if="waitingPlayers.length === 0 && answeredPlayers.length > 0" class="list-unstyled">
          <li><em>All answers received!</em></li>
        </ul>

        <ul v-else class="list-unstyled">
          <li
            v-for="name in waitingPlayers"
            :key="'waiting-' + name"
          >
            {{ name }}
          </li>
        </ul>
      </div>

      <div v-else-if="gameState == 4">
        <h2>Time to vote!</h2>
        <h4 class="mt-3">{{ prompt }}</h4>

        <div class="mt-3">
          <h5>Answer A:</h5>
          <p>{{ ans1 }}</p>
        </div>

        <div class="mt-2">
          <h5>Answer B:</h5>
          <p>{{ ans2 }}</p>
        </div>

        <p class="mt-3"><em>Vote on your device now.</em></p>

        <h3 class="mt-4">Voting progress</h3>

        <p class="mb-1"><strong>Voted:</strong></p>
        <ul class="list-unstyled">
          <li v-if="votedPlayers.length === 0"><em>Nobody has voted yet...</em></li>
          <li v-for="name in votedPlayers" :key="'voted-' + name">
            {{ name }}
          </li>
        </ul>

        <p class="mb-1 mt-3"><strong>Still waiting on:</strong></p>

        <ul class="list-unstyled" v-if="waitingVoters.length === 0 && votedPlayers.length > 0">
          <li><em>All votes received!</em></li>
        </ul>

        <ul class="list-unstyled" v-else-if="waitingVoters.length === 0 && votedPlayers.length === 0">
          <li><em>Waiting for players to start voting...</em></li>
        </ul>

        <ul class="list-unstyled" v-else>
          <li
            v-for="name in waitingVoters"
            :key="'waiting-vote-' + name"
          >
            {{ name }}
          </li>
        </ul>
      </div>

      <div v-else-if="gameState == 5">
        <h2>Results are in</h2>
        <h4 class="mt-3">{{ prompt }}</h4>

        <div v-if="res && res.length > 0">
          <div
            class="result-row"
            v-for="(item, idx) in res"
            :key="item.user + '-' + idx"
          >
            <div class="result-text">
              <strong>Answer {{ String.fromCharCode(65 + idx) }}</strong>
              <p>{{ item.text || '(no answer)' }}</p>
            </div>
            <div class="result-meta">
              <p>By: <strong>{{ item.user }}</strong></p>
              <p>Votes: <strong>{{ item.votes }}</strong></p>

              <p class="mb-1 mt-2"><small>Voted by:</small></p>
              <ul class="mb-0 ps-3">
                <li v-if="!item.voters || item.voters.length === 0">
                  <em>No votes for this answer</em>
                </li>
                <li
                  v-for="vName in item.voters"
                  :key="'disp-voter-' + idx + '-' + vName"
                >
                  {{ vName }}
                </li>
              </ul>
            </div>
          </div>
      </div>

      <div v-else>
        <em>Waiting for results data...</em>
      </div>
      </div>

      <div v-else-if="gameState == 6">
        <h2>Scoreboard</h2>
        <ol class="scores-list mt-3">
          <li
            v-if="sortedScores.length === 0"
          >
            <em>No scores yet…</em>
          </li>

          <li
            v-for="player in sortedScores"
            :key="'score-' + player[0]"
            class="scores-item"
          >
            <span class="player-name">{{ player[0] }}</span>
            <span class="player-score">{{ player[1] }}</span>
          </li>
        </ol>
      </div>

      <div v-else-if="gameState == 7">
        <h2>Game Over</h2>

        <h3 class="mt-3">Final leaderboard</h3>
        <ol class="scores-list mt-2">
          <li
            v-if="sortedScores.length === 0"
          >
            <em>No scores yet…</em>
          </li>

          <li
            v-for="player in sortedScores"
            :key="'final-' + player[0]"
            class="scores-item"
          >
            <span class="player-name">{{ player[0] }}</span>
            <span class="player-score">{{ player[1] }}</span>
          </li>
        </ol>

        <h3 class="mt-4">Podium</h3>
        <ol class="scores-list mt-2">
          <li
            v-if="podium.length === 0"
          >
            <em>No winners yet…</em>
          </li>

          <li
            v-for="p in podium"
            :key="'podium-' + p[0]"
            class="scores-item"
          >
            <span class="player-name">{{ p[0] }}</span>
            <span class="player-score">{{ p[1] }}</span>
          </li>
        </ol>
      </div>

    </div>
  </div>

  <%- include('footer'); -%>

</html>
