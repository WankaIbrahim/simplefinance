<div class="admin-container">
  <div class="admin-card">
    <h2 class="mb-3">Admin Controls</h2>
    <p class="mb-4"><em>You are the game host. Use these buttons to control the game.</em></p>

    <div class="admin-buttons">
      <button class="btn btn-success" @click="startGame()">Start Game</button>
      <button class="btn btn-primary" @click="adminNext()">Next</button>
      <button class="btn btn-danger" @click="newGame()">Reset Game</button>
    </div>
  </div>
</div>
