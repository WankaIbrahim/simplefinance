<div class="prompt-container">
  <div class="prompt-card" v-if="!gameInfo[2].success">
    <h2>Suggest a prompt</h2>
    <p>Think of a funny question or prompt for other players to answer.</p>

    <div class="prompt-input-row">
      <input
        type="text"
        v-model="userPrompt"
        @keyup.enter="sendPrompt()"
        placeholder="Enter prompt (20–100 characters)…"
      >
      <button @click="sendPrompt()">Done</button>
    </div>
  </div>

  <div class="prompt-card" v-else>
    <h2>Prompt submitted!</h2>
    <p>Waiting for other players to submit their prompts…</p>
  </div>
</div>
